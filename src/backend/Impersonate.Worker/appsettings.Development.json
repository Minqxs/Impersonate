{
  "ConnectionStrings": {
    "ImpersonateDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=Impersonate_Development;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Delivery": {
    "GitHubMcp": {
      "Enabled": true,
      "Transport": "Remote",
      "ServerId": "github-official",
      "RemoteUrl": "https://api.githubcopilot.com/mcp/",
      "TokenEnvironmentVariable": "GITHUB_MCP_TOKEN",
      "AllowedRepositories": [ "Minqxs/TaskIt" ],
      "Tools": [ "list_pull_requests", "pull_request_read", "create_pull_request", "update_pull_request", "merge_pull_request" ],
      "TimeoutSeconds": 60,
      "DraftPullRequests": true
    }
  }
}
