{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/engineering-personality/personality-profile.schema.json",
  "title": "Engineering Personality Main Profile",
  "type": "object",
  "required": [
    "profile",
    "identity",
    "files",
    "deviation_policy",
    "approval_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "description",
        "created_at",
        "last_updated_at",
        "status",
        "source_snapshot_date",
        "authority_boundary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "last_updated_at": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "source_snapshot_date": {
          "type": "string"
        },
        "authority_boundary": {
          "const": "guidance-not-source-of-truth"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineering_philosophy",
        "value_philosophy",
        "communication_style"
      ],
      "properties": {
        "engineering_philosophy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "value_philosophy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "communication_style": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "type": "string"
      }
    },
    "deviation_policy": {
      "type": "object"
    },
    "approval_policy": {
      "type": "object"
    }
  }
}
