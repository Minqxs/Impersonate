{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/engineering-personality/role-overlay.schema.json",
  "title": "Engineering Personality Role Overlay",
  "type": "object",
  "required": [
    "role"
  ],
  "additionalProperties": false,
  "properties": {
    "role": {
      "type": "object",
      "required": [
        "id",
        "inherits",
        "purpose",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "inherits": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "rule.schema.json"
          }
        }
      }
    }
  }
}
